.DS_Store

# Personal session state (handoff skill)
handoffs/

# Research notes and testbed findings — working material, stays local
research/
report.md

# Loose notes: critique from other sessions, reports, parked items.
# Summarised into PLAN.md when acted on, then deleted.
notes/

# Secrets. A filled .env never belongs in git — template/.env.example is
# the only version that does.
.env
.env.*
!.env.example

# Local agent setup for working on this repo. Nothing under here ships in
# the template, and it holds personal files: the greet brief, local
# scripts, tool credentials.
.claude/
