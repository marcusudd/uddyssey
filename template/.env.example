# Jira access for the tickets skill. Copy to .env and fill in.
# One API token per team member, created at
# https://id.atlassian.com/manage-profile/security/api-tokens
# Never commit .env — only this example file belongs in git.
JIRA_BASE_URL=https://yourteam.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ
